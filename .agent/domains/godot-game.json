{
  "domain": "godot-game",
  "version": "1.0",
  "trigger": {
    "file": "project.godot"
  },
  "primary_agent": "game-developer",
  "supporting_agents": [],
  "skills": {
    "p0": [
      "godot-gdscript-patterns",
      "game-development"
    ],
    "p1": [
      "game-development/2d-games",
      "game-development/game-art"
    ],
    "p2": [
      "game-development/web-games",
      "game-development/mobile-games"
    ]
  },
  "workflows": [
    "/debug",
    "/scene",
    "/export"
  ],
  "rules_file": "rules/domains/godot-game-rules.md",
  "mcp_extra": [
    "godot-mcp"
  ],
  "mcp_status": "LIVE_TESTED",
  "mcp_test_date": "2026-03-08",
  "mcp_notes": "stdio transport. Original 14-tool version (NOT the 149-tool fork). Path must be hardcoded in config or GODOT_PATH env var must be set.",
  "mcp_config_when_ready": {
    "godot": {
      "command": "npx",
      "args": [
        "-y",
        "godot-mcp"
      ],
      "env": {
        "GODOT_PATH": "<godot-executable-path>"
      }
    }
  }
}
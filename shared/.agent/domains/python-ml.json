{
  "domain": "python-ml",
  "version": "1.0",
  "trigger": {
    "strategy": "any_match",
    "checks": [
      {
        "file": "pyproject.toml",
        "contains_any": ["torch", "tensorflow", "opencv", "cv2"]
      },
      {
        "file": "requirements.txt",
        "contains_any": ["torch", "tensorflow", "opencv-python", "scikit-image"]
      }
    ]
  },
  "primary_agent": "backend-specialist",
  "supporting_agents": [
    "performance-optimizer"
  ],
  "skills": {
    "p0": [
      "python-patterns",
      "clean-code"
    ],
    "p1": [
      "testing-patterns",
      "performance-profiling"
    ],
    "p2": [
      "data-engineer"
    ]
  },
  "workflows": [
    "/debug",
    "/verify"
  ],
  "mcp_extra": [],
  "rules_file": "rules/domains/python-data-rules.md",
  "notes": "ML/CV/Image processing. GPU optimization, batch processing, NumPy vectorization."
}
